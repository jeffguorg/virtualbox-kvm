# Maintainer: jeffguorg <https://github.com/jeffguorg/virtualbox-kvm>
#
# VirtualBox with:
#   * the cyberus-technology KVM backend patch (driverless, /dev/kvm based)
#   * the LinuxBridge network driver: first-class "LinuxBridge" attachment
#     type connecting VMs to a Linux host bridge (e.g. vboxbr0) without any
#     VirtualBox kernel modules
#
# The repository-root patches directory is canonical. Local patch symlinks
# make those patches available as makepkg sources in the ordered series below.
pkgname=virtualbox-kvm-jeffguorg-patched
pkgver=7.2.20
pkgrel=6
pkgdesc='VirtualBox with KVM backend and LinuxBridge host networking (driverless, no kernel modules)'
arch=('x86_64')
# Arch debug-package convention: makepkg strips binaries as usual and splits
# the extracted debug symbols into virtualbox-kvm-jeffguorg-patched-debug.
options=(debug)
url='https://github.com/jeffguorg/virtualbox-kvm'
license=('GPL-3.0-only')
depends=(
  'qt6-base' 'qt6-tools' 'qt6-scxml' 'libxkbcommon'
  'libx11' 'libxext' 'libxcursor' 'libxinerama' 'libxrandr' 'libxmu'
  'mesa' 'libglvnd' 'glslang'
  'alsa-lib'
  'curl' 'libpng' 'libvpx' 'opus' 'libxml2' 'libxslt' 'openssl' 'zlib'
  'libcap' 'lvm2'
)
makedepends=(
  'acpica' 'nasm' 'yasm' 'xorgproto'
)
conflicts=('virtualbox' 'virtualbox-kvm')
provides=('virtualbox')
install='virtualbox-kvm-jeffguorg-patched.install'
source=(
  "https://download.virtualbox.org/virtualbox/${pkgver}/VirtualBox-${pkgver}.tar.bz2"
  '0001-NEM-Implement-KVM-backend.patch'
  '0002-NEM-fix-VMMStatic-build.patch'
  '0003-LinuxBridge-driver.patch'
  '0004-LinuxBridge-helper-and-host-integration.patch'
  '0005-LinuxBridge-attachment-type.patch'
  '0006-LinuxBridge-own-CFGM-strings-in-process-heap.patch'
  'makeself.sh'
)
sha256sums=(
  '5c2138213b72f36c129b92c2c267f2a40e9c98513f4c86a584327f09f9be706d'
  'cf6c8ec1d23b378e67939dff6affaa1a99587552100c2c5a147289fe3bb8e85a'
  'c4b4b29a370f3441e03c3a6fc153a36bdac53b9960e04283577cb88787adf862'
  'b25124c00c050f84775d749acf4c8bfee61a55c88700d8dd238a73d1a32555a5'
  '404c7de518e87d8745811686983e902b4ce6e066d17286aa72b0e388f9ebbdb3'
  '9e95e37725e2001d111d0a65297d0fdb2e3addf0d6fefdbbf1acfbb9d741f629'
  'edbbc4761d593d536d69af39bcb8c0c30cb8afa9ff5b3a74f09f3e146d86c547'
  '2e73c14412b52124abfc832dd94c9178ff2567b1cce0fb502443d1d1965e2935'
)

prepare() {
  cd "VirtualBox-${pkgver}"

  # Driverless KVM backend, then the LinuxBridge network stack on top.
  patch -Np1 < "${srcdir}/0001-NEM-Implement-KVM-backend.patch"
  patch -Np1 < "${srcdir}/0002-NEM-fix-VMMStatic-build.patch"
  patch -Np1 < "${srcdir}/0003-LinuxBridge-driver.patch"
  patch -Np1 < "${srcdir}/0004-LinuxBridge-helper-and-host-integration.patch"
  patch -Np1 < "${srcdir}/0005-LinuxBridge-attachment-type.patch"
  patch -Np1 < "${srcdir}/0006-LinuxBridge-own-CFGM-strings-in-process-heap.patch"

  # configure requires a 'makeself' tool (only used for the .run installer we
  # never produce); the upstream release ships none in PATH, so provide one.
  install -Dm755 "${srcdir}/makeself.sh" "${srcdir}/tools-bin/makeself"
}

build() {
  cd "VirtualBox-${pkgver}"

  export PATH="${srcdir}/tools-bin:${PATH}"

  ./configure \
    --with-kvm \
    --disable-kmods \
    --disable-docs \
    --disable-hardening \
    --disable-java \
    --disable-sdl \
    --disable-python

  source ./env.sh
  kmk
}

package() {
  cd "VirtualBox-${pkgver}/out/linux.amd64/release/bin"

  install -dm755 "${pkgdir}/usr/lib/virtualbox"
  cp -a . "${pkgdir}/usr/lib/virtualbox/"

  # Drop build-time/test/SDK artifacts.
  rm -rf "${pkgdir}/usr/lib/virtualbox/"{testcase,sdk,src,obj}
  rm -f "${pkgdir}/usr/lib/virtualbox/"*.debug
  rm -f "${pkgdir}/usr/lib/virtualbox/bldRTLdrCheckImports"
  rm -f "${pkgdir}/usr/lib/virtualbox/NemRawBench-1"
  rm -f "${pkgdir}/usr/lib/virtualbox/VBoxDDR0.debug"

  # The bridge helper must be setuid root (statically linked, restricted to
  # vboxtap* interfaces, ownership root:root by package default).
  chmod 4755 "${pkgdir}/usr/lib/virtualbox/VBoxNetBrCtl"

  # Terminal entry points.
  install -dm755 "${pkgdir}/usr/bin"
  local _bin
  for _bin in VirtualBox VirtualBoxVM VBoxManage VBoxHeadless; do
    ln -sf "/usr/lib/virtualbox/${_bin}" "${pkgdir}/usr/bin/${_bin}"
  done

  # Host bridge helper (creates vboxbr0 + dnsmasq).
  install -Dm755 "${srcdir}/VirtualBox-${pkgver}/src/VBox/Installer/linux/vboxbr0-setup.sh" \
    "${pkgdir}/usr/bin/vboxbr0-setup"

  # GUI: desktop entries and icons (generated/built into bin/).
  install -Dm644 virtualbox.desktop \
    "${pkgdir}/usr/share/applications/virtualbox.desktop"
  install -Dm644 virtualboxvm.desktop \
    "${pkgdir}/usr/share/applications/virtualboxvm.desktop"
  local _size
  for _icon in icons/*/virtualbox.png; do
    [ -f "${_icon}" ] || continue
    _size="$(basename "$(dirname "${_icon}")")"
    install -Dm644 "${_icon}" \
      "${pkgdir}/usr/share/icons/hicolor/${_size}/apps/virtualbox.png"
  done

  # License.
  install -Dm644 "${srcdir}/VirtualBox-${pkgver}/COPYING" \
    "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
