+                    pThis->pDrvIns->iInstance, pThis->pszIfName, strerror(iErr)));
+            char szUid[32];
+            RTStrPrintf(szUid, sizeof(szUid), "%d", (int)getuid());
+            int rc = drvLinuxBridgeRunCtl2(pThis, "create", szUid);
+            if (RT_SUCCESS(rc))
+                rc = ioctl(fd, TUNSETIFF, &IfReq) == 0 ? VINF_SUCCESS : -errno;
+            if (RT_FAILURE(rc))
+            {
+                close(fd);
+                return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                           N_("Failed to create TAP interface '%s' via VBoxNetBrCtl: %Rrc"),
+                                           pThis->pszIfName, rc);
+            }
+        }
+        else
+        {
+            close(fd);
+            return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                       N_("TUNSETIFF failed for '%s': %s"), pThis->pszIfName, strerror(iErr));
