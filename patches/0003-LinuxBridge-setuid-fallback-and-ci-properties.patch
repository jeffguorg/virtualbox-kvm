+/**
+ * Runs "VBoxNetBrCtl <action> <ifname> <extra-arg>" and waits for it.
+ *
+ * Same as drvLinuxBridgeRunCtl, but the fourth argument is not a bridge name
+ * (used for "create <ifname> <uid>").
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszAction   "create".
+ * @param   pszExtra    The extra argument (uid string).
+ */
+static int drvLinuxBridgeRunCtl2(PDRVLINUXBRIDGE pThis, const char *pszAction, const char *pszExtra)
+{
+    char szCtl[RTPATH_MAX];
+    int rc = drvLinuxBridgeResolveCtlPath(pThis, szCtl, sizeof(szCtl));
+    if (RT_FAILURE(rc))
+        return rc;
+
+    const char *apszArgs[5];
+    apszArgs[0] = szCtl;
+    apszArgs[1] = pszAction;
+    apszArgs[2] = pThis->pszIfName;
+    apszArgs[3] = pszExtra;
+    apszArgs[4] = NULL;
+
+    RTPROCESS hProc;
+    rc = RTProcCreate(szCtl, apszArgs, RTENV_DEFAULT, 0 /*fFlags*/, &hProc);
+    if (RT_FAILURE(rc))
+        return rc;
+
+    RTPROCSTATUS Status;
+    rc = RTProcWait(hProc, 0 /*fFlags*/, &Status);
+    if (RT_FAILURE(rc))
+        return rc;
+    if (Status.enmReason != RTPROCEXITREASON_NORMAL || Status.iStatus != 0)
+    {
+        LogRel(("LinuxBridge#%d: '%s %s %s %s' failed: iStatus=%d enmReason=%d\n",
+                pThis->pDrvIns->iInstance, szCtl, pszAction, pThis->pszIfName,
+                pszExtra, Status.iStatus, Status.enmReason));
+        return VERR_ACCESS_DENIED;
+    }
+    return VINF_SUCCESS;
+}
