+/**
+ * Finds the actual (stored) name of a config value, case-insensitively.
+ *
+ * Property names come from user supplied generic driver properties and may
+ * be in any case, while CFGM itself is strictly case-sensitive.
+ *
+ * @returns VINF_SUCCESS or VERR_CFGM_VALUE_NOT_FOUND.
+ */
+static int drvLinuxBridgeFindKeyCI(PCPDMDRVHLPR3 pHlp, PCFGMNODE pCfg, const char *pszKey,
+                                   char *pszActual, size_t cbActual)
+{
+    for (PCFGMLEAF pLeaf = pHlp->pfnCFGMGetFirstValue(pCfg); pLeaf; pLeaf = pHlp->pfnCFGMGetNextValue(pLeaf))
+    {
+        int rc = pHlp->pfnCFGMGetValueName(pLeaf, pszActual, cbActual);
+        if (RT_SUCCESS(rc) && RTStrICmp(pszActual, pszKey) == 0)
+            return VINF_SUCCESS;
+    }
+    return VERR_CFGM_VALUE_NOT_FOUND;
+}
+
+
+/**
+ * Queries a string value by case-insensitive key name (MM-heap allocated).
+ *
+ * @returns VBox status code (VERR_CFGM_VALUE_NOT_FOUND if absent).
+ */
+static int drvLinuxBridgeQueryStringCI(PPDMDRVINS pDrvIns, PCFGMNODE pCfg, const char *pszKey, char **ppsz)
+{
+    PCPDMDRVHLPR3 pHlp  = pDrvIns->pHlpR3;
+    char          szActual[64];
+    int rc = drvLinuxBridgeFindKeyCI(pHlp, pCfg, pszKey, szActual, sizeof(szActual));
+    if (RT_FAILURE(rc))
+        return rc;
+    return pHlp->pfnCFGMQueryStringAlloc(pCfg, szActual, ppsz);
+}
