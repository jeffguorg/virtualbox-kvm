+/*********************************************************************************************************************************
+*   Structures and Typedefs                                                                                                      *
+*********************************************************************************************************************************/
+/**
+ * LinuxBridge driver instance data.
+ *
+ * @implements PDMINETWORKUP
+ */
+typedef struct DRVLINUXBRIDGE
+{
+    /** The network interface. */
+    PDMINETWORKUP           INetworkUp;
+    /** The network port interface of the driver/device above us. */
+    PPDMINETWORKDOWN        pIAboveNet;
+    /** Pointer to the driver instance. */
+    PPDMDRVINS              pDrvIns;
+    /** TAP device file handle. */
+    RTFILE                  hFileDevice;
+    /** The TAP device name (always "vboxtap*" prefixed). */
+    char                   *pszIfName;
+    /** The host bridge name. */
+    char                   *pszBridge;
+    /** Explicit path of the VBoxNetBrCtl helper, NULL for default lookup. */
+    char                   *pszCtlPath;
+    /** Whether the helper successfully attached the TAP to the bridge. */
+    bool                    fAttached;
+    /** Whether to detach on terminate (default true). */
+    bool                    fDetachOnTerminate;
+    /** The write end of the control pipe. */
+    RTPIPE                  hPipeWrite;
+    /** The read end of the control pipe. */
+    RTPIPE                  hPipeRead;
+    /** Reader thread. */
+    PPDMTHREAD              pThread;
+    /** Transmit lock used by drvLinuxBridgeNetworkUp_BeginXmit. */
+    RTCRITSECT              XmitLock;
+
+#ifdef VBOX_WITH_STATISTICS
+    /** Number of sent packets. */
+    STAMCOUNTER             StatPktSent;
+    /** Number of sent bytes. */
+    STAMCOUNTER             StatPktSentBytes;
+    /** Number of received packets. */
+    STAMCOUNTER             StatPktRecv;
+    /** Number of received bytes. */
+    STAMCOUNTER             StatPktRecvBytes;
+    /** Profiling packet transmit runs. */
+    STAMPROFILE             StatTransmit;
+    /** Profiling packet receive runs. */
+    STAMPROFILEADV          StatReceive;
+#endif /* VBOX_WITH_STATISTICS */
+} DRVLINUXBRIDGE, *PDRVLINUXBRIDGE;
+
+
+/** Converts a pointer to DRVLINUXBRIDGE::INetworkUp to a PDRVLINUXBRIDGE. */
+#define PDMINETWORKUP_2_DRVLINUXBRIDGE(pInterface) \
+    ( (PDRVLINUXBRIDGE)((uintptr_t)pInterface - RT_UOFFSETOF(DRVLINUXBRIDGE, INetworkUp)) )
+
+
+/*********************************************************************************************************************************
+*   Internal Functions                                                                                                           *
+*********************************************************************************************************************************/
+/**
+ * Locates the VBoxNetBrCtl helper executable.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszBuf      Where to store the full path.
+ * @param   cbBuf       Size of the buffer.
+ */
+static int drvLinuxBridgeResolveCtlPath(PDRVLINUXBRIDGE pThis, char *pszBuf, size_t cbBuf)
+{
+    int rc;
+    if (pThis->pszCtlPath && *pThis->pszCtlPath)
+        rc = RTStrCopy(pszBuf, cbBuf, pThis->pszCtlPath);
+    else
+    {
+        rc = RTPathExecDir(pszBuf, cbBuf - sizeof("/VBoxNetBrCtl"));
+        if (RT_SUCCESS(rc))
+            rc = RTStrCat(pszBuf, cbBuf, "/VBoxNetBrCtl");
+    }
+    if (RT_FAILURE(rc))
+        return rc;
+    if (!RTPathExists(pszBuf))
+        return VERR_FILE_NOT_FOUND;
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * Runs "VBoxNetBrCtl <action> <ifname> [bridge]" and waits for it.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszAction   "attach" or "detach".
+ * @param   pszBridge   The bridge name, NULL for detach.
+ */
+static int drvLinuxBridgeRunCtl(PDRVLINUXBRIDGE pThis, const char *pszAction, const char *pszBridge)
+{
+    char szCtl[RTPATH_MAX];
+    int rc = drvLinuxBridgeResolveCtlPath(pThis, szCtl, sizeof(szCtl));
+    if (RT_FAILURE(rc))
+    {
+        LogRel(("LinuxBridge#%d: cannot find VBoxNetBrCtl helper (%Rrc)\n", pThis->pDrvIns->iInstance, rc));
+        return rc;
+    }
+
+    const char *apszArgs[5];
+    apszArgs[0] = szCtl;
+    apszArgs[1] = pszAction;
+    apszArgs[2] = pThis->pszIfName;
+    apszArgs[3] = pszBridge;
+    apszArgs[4] = NULL;
+
+    RTPROCESS hProc;
+    rc = RTProcCreate(szCtl, apszArgs, RTENV_DEFAULT, 0 /*fFlags*/, &hProc);
+    if (RT_FAILURE(rc))
+    {
+        LogRel(("LinuxBridge#%d: failed to execute '%s %s %s %s': %Rrc\n",
+                pThis->pDrvIns->iInstance, szCtl, pszAction, pThis->pszIfName,
+                pszBridge ? pszBridge : "", rc));
+        return rc;
+    }
+
+    RTPROCSTATUS Status;
+    rc = RTProcWait(hProc, 0 /*fFlags*/, &Status);
+    if (RT_FAILURE(rc))
+        return rc;
+    if (Status.enmReason != RTPROCEXITREASON_NORMAL || Status.iStatus != 0)
+    {
+        LogRel(("LinuxBridge#%d: '%s %s %s %s' failed: iStatus=%d enmReason=%d\n",
+                pThis->pDrvIns->iInstance, szCtl, pszAction, pThis->pszIfName,
+                pszBridge ? pszBridge : "", Status.iStatus, Status.enmReason));
+        return VERR_ACCESS_DENIED;
+    }
+    return VINF_SUCCESS;
+}
+
+/**
+ * Runs "VBoxNetBrCtl create <ifname> <uid>" and waits for it, capturing the
+ * created interface name printed by the helper on stdout.
+ *
+ * The helper always reports the concrete name it created; this is essential
+ * when ifname is a "%d" template, because the kernel substitutes the unit
+ * number and re-issuing TUNSETIFF with the template would allocate a second
+ * interface.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszUid      The owner uid argument.
+ * @param   pszName     Where to store the reported interface name ("" on failure).
+ * @param   cbName      Size of the name buffer.
+ */
+static int drvLinuxBridgeRunCtlCreate(PDRVLINUXBRIDGE pThis, const char *pszUid,
+                                      char *pszName, size_t cbName)
+{
+    RTStrCopy(pszName, cbName, "");
+
+    char szCtl[RTPATH_MAX];
+    int rc = drvLinuxBridgeResolveCtlPath(pThis, szCtl, sizeof(szCtl));
+    if (RT_FAILURE(rc))
+        return rc;
+
+    const char *apszArgs[5];
+    apszArgs[0] = szCtl;
+    apszArgs[1] = "create";
+    apszArgs[2] = pThis->pszIfName;
+    apszArgs[3] = pszUid;
+    apszArgs[4] = NULL;
+
+    RTPIPE hPipeR = NIL_RTPIPE;
+    RTPIPE hPipeW = NIL_RTPIPE;
+    rc = RTPipeCreate(&hPipeR, &hPipeW, 0 /*fFlags*/);
+    AssertRCReturn(rc, rc);
+
+    RTHANDLE hStdOut;
+    hStdOut.enmType     = RTHANDLETYPE_PIPE;
+    hStdOut.u.hPipe     = hPipeW;
+
+    RTPROCESS hProc;
+    rc = RTProcCreateEx(szCtl, apszArgs, RTENV_DEFAULT, 0 /*fFlags*/,
+                        NULL /*phStdIn*/, &hStdOut, NULL /*phStdErr*/,
+                        NULL /*pszAsUser*/, NULL /*pszPassword*/, NULL /*pvExtraData*/, &hProc);
+    RTPipeClose(hPipeW);
+    if (RT_FAILURE(rc))
+    {
+        RTPipeClose(hPipeR);
+        return rc;
+    }
+
+    RTPROCSTATUS Status;
+    rc = RTProcWait(hProc, 0 /*fFlags*/, &Status);
+
+    /* The helper only prints the interface name (plus newline), so draining
+       after the wait cannot deadlock. */
+    size_t off = 0;
+    for (;;)
+    {
+        size_t cbRead = 0;
+        int rc2 = RTPipeRead(hPipeR, &pszName[off], cbName - 1 - off, &cbRead);
+        if (RT_FAILURE(rc2) || cbRead == 0)
+            break;
+        off += cbRead;
+        if (off >= cbName - 1)
+            break;
+    }
+    RTPipeClose(hPipeR);
+    pszName[off] = '\0';
+    while (off > 0 && (pszName[off - 1] == '\n' || pszName[off - 1] == '\r'))
+        pszName[--off] = '\0';
+
+    if (RT_FAILURE(rc))
+        return rc;
+    if (Status.enmReason != RTPROCEXITREASON_NORMAL || Status.iStatus != 0)
+    {
+        LogRel(("LinuxBridge#%d: 'VBoxNetBrCtl create %s %s' failed: iStatus=%d enmReason=%d\n",
+                pThis->pDrvIns->iInstance, pThis->pszIfName, pszUid, Status.iStatus, Status.enmReason));
+        return VERR_ACCESS_DENIED;
+    }
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * Runs "VBoxNetBrCtl <action> <arg1> <arg2>" and waits for it, capturing
+ * stderr into a caller buffer for error reporting.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszAction   The helper subcommand ("ensurebridge").
+ * @param   pszArg1     First argument (bridge name).
+ * @param   pszArg2     Second argument (CIDR), may be NULL.
+ * @param   pszDiag     Where to store captured stderr (always set).
+ * @param   cbDiag      Size of the diagnostics buffer.
+ */
+static int drvLinuxBridgeRunCtlCapture(PDRVLINUXBRIDGE pThis, const char *pszAction,
+                                       const char *pszArg1, const char *pszArg2,
+                                       char *pszDiag, size_t cbDiag)
+{
+    RTStrCopy(pszDiag, cbDiag, "no details");
+
+    char szCtl[RTPATH_MAX];
+    int rc = drvLinuxBridgeResolveCtlPath(pThis, szCtl, sizeof(szCtl));
+    if (RT_FAILURE(rc))
+    {
+        RTStrPrintf(pszDiag, cbDiag, "VBoxNetBrCtl helper not found (%Rrc)", rc);
+        return rc;
+    }
+
+    const char *apszArgs[5];
+    apszArgs[0] = szCtl;
+    apszArgs[1] = pszAction;
+    apszArgs[2] = pszArg1;
+    apszArgs[3] = pszArg2;
+    apszArgs[4] = NULL;
+
+    RTPIPE hPipeR = NIL_RTPIPE;
+    RTPIPE hPipeW = NIL_RTPIPE;
+    rc = RTPipeCreate(&hPipeR, &hPipeW, 0 /*fFlags*/);
+    AssertRCReturn(rc, rc);
+
+    RTHANDLE hStdErr;
+    hStdErr.enmType     = RTHANDLETYPE_PIPE;
+    hStdErr.u.hPipe     = hPipeW;
+
+    RTPROCESS hProc;
+    rc = RTProcCreateEx(szCtl, apszArgs, RTENV_DEFAULT, 0 /*fFlags*/,
+                        NULL /*phStdIn*/, NULL /*phStdOut*/, &hStdErr,
+                        NULL /*pszAsUser*/, NULL /*pszPassword*/, NULL /*pvExtraData*/, &hProc);
+    RTPipeClose(hPipeW);
+    if (RT_FAILURE(rc))
+    {
+        RTPipeClose(hPipeR);
+        RTStrPrintf(pszDiag, cbDiag, "failed to execute '%s'", szCtl);
+        return rc;
+    }
+
+    RTPROCSTATUS Status;
+    rc = RTProcWait(hProc, 0 /*fFlags*/, &Status);
+
+    /* The helper only ever prints a few hundred bytes, so draining after the
+       wait cannot deadlock. */
+    size_t off = 0;
+    for (;;)
+    {
+        size_t cbRead = 0;
+        int rc2 = RTPipeRead(hPipeR, &pszDiag[off], cbDiag - 1 - off, &cbRead);
+        if (RT_FAILURE(rc2) || cbRead == 0)
+            break;
+        off += cbRead;
+        if (off >= cbDiag - 1)
+            break;
+    }
+    RTPipeClose(hPipeR);
+    pszDiag[off] = '\0';
+    while (off > 0 && (pszDiag[off - 1] == '\n' || pszDiag[off - 1] == '\r'))
+        pszDiag[--off] = '\0';
+
+    if (RT_FAILURE(rc))
+        return rc;
+    if (Status.enmReason != RTPROCEXITREASON_NORMAL || Status.iStatus != 0)
+        return VERR_HOSTIF_INIT_FAILED;
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * Creates the TAP interface and attaches it to the host bridge.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ */
+static int drvLinuxBridgeAttach(PDRVLINUXBRIDGE pThis)
+{
+    /*
+     * Open the TUN/TAP control device and create the interface.
+     */
+    int fd = open("/dev/net/tun", O_RDWR | O_NONBLOCK);
+    if (fd < 0)
+        return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                   N_("Failed to open /dev/net/tun: %s (check tun module and group access)"),
+                                   strerror(errno));
+
+    struct ifreq IfReq;
+    memset(&IfReq, 0, sizeof(IfReq));
+    IfReq.ifr_flags = IFF_TAP | IFF_NO_PI;
+    RTStrCopy(IfReq.ifr_name, sizeof(IfReq.ifr_name), pThis->pszIfName);
+    if (ioctl(fd, TUNSETIFF, &IfReq) < 0)
+    {
+        int const iErr = errno;
+
+        /*
+         * Creating a new TAP interface requires CAP_NET_ADMIN, which the VM
+         * process does not have.  Fall back to the setuid helper creating a
+         * persistent interface owned by us, then attach to it by name
+         * (attach-by-name works for the owner without any capability).
+         */
+        if (iErr == EPERM || iErr == EACCES)
+        {
+            LogRel(("LinuxBridge#%d: TUNSETIFF for '%s' failed with %s, asking VBoxNetBrCtl to create it\n",
+                    pThis->pDrvIns->iInstance, pThis->pszIfName, strerror(iErr)));
+            char szUid[32];
+            RTStrPrintf(szUid, sizeof(szUid), "%d", (int)getuid());
+            char szActual[IFNAMSIZ];
+            int rc = drvLinuxBridgeRunCtlCreate(pThis, szUid, szActual, sizeof(szActual));
+            if (RT_SUCCESS(rc))
+            {
+                /* Adopt the concrete name the helper created before attaching
+                   by name.  This is mandatory for "%d" templates: re-issuing
+                   TUNSETIFF with the template would allocate a second
+                   interface and leak the helper's one. */
+                if (szActual[0] == '\0')
+                    rc = VERR_NOT_SUPPORTED;
+                else
+                {
+                    char *pszActual = RTStrDup(szActual);
+                    if (pszActual)
+                    {
+                        RTStrFree(pThis->pszIfName);
+                        pThis->pszIfName = pszActual;
+                        RTStrCopy(IfReq.ifr_name, sizeof(IfReq.ifr_name), pThis->pszIfName);
+                        rc = ioctl(fd, TUNSETIFF, &IfReq) == 0 ? VINF_SUCCESS : -errno;
+                    }
+                    else
+                        rc = VERR_NO_MEMORY;
+                }
+            }
+            if (RT_FAILURE(rc))
+            {
+                close(fd);
+                if (rc == VERR_NOT_SUPPORTED)
+                    return PDMDrvHlpVMSetError(pThis->pDrvIns, rc, RT_SRC_POS,
+                                               N_("VBoxNetBrCtl did not report the created interface name; "
+                                                  "the helper is too old for '%%d' name templates"));
+                return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                           N_("Failed to create TAP interface '%s' via VBoxNetBrCtl: %Rrc"),
+                                           pThis->pszIfName, rc);
+            }
+        }
+        else
+        {
+            close(fd);
+            return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                       N_("TUNSETIFF failed for '%s': %s"), pThis->pszIfName, strerror(iErr));
+        }
+    }
+
+    /*
+     * Make sure the interface is non-persistent: when the VM releases the
+     * fd (clean exit or crash), the kernel removes the TAP device and its
+     * bridge membership automatically.  For an interface we own this ioctl
+     * needs no capability.
+     */
+    if (ioctl(fd, TUNSETPERSIST, 0) < 0)
+        LogRel(("LinuxBridge#%d: warning: failed to clear persistence of '%s': %s\n",
+                pThis->pDrvIns->iInstance, pThis->pszIfName, strerror(errno)));
+
+    /* TUNSETIFF returns the name it actually bound.  With a concrete requested
+       name that is the same name, but a "%d" template comes back substituted
+       with the unit number the kernel allocated; adopt the concrete name so
+       that bridge attach/detach and logging refer to the real interface. */
+    if (RTStrStr(pThis->pszIfName, "%") != NULL)
+    {
+        char *pszActual = RTStrDup(IfReq.ifr_name);
+        if (pszActual)
+        {
+            RTStrFree(pThis->pszIfName);
+            pThis->pszIfName = pszActual;
+        }
+        else
+        {
+            close(fd);
+            return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_NO_MEMORY, RT_SRC_POS,
+                                       N_("Failed to record the allocated TAP interface name"));
+        }
+    }
+
+    pThis->hFileDevice = (RTFILE)(uintptr_t)fd;
+
+    /*
+     * Enslave to the host bridge via the setuid helper.
+     */
+    int rc = drvLinuxBridgeRunCtl(pThis, "attach", pThis->pszBridge);
+    if (RT_FAILURE(rc))
+        return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                   N_("Failed to attach '%s' to bridge '%s' via VBoxNetBrCtl; "
+                                      "is the bridge configured and VBoxNetBrCtl installed setuid root?"),
+                                   pThis->pszIfName, pThis->pszBridge);
+    pThis->fAttached = true;
+    LogRel(("LinuxBridge#%d: attached '%s' to bridge '%s'\n",
+            pThis->pDrvIns->iInstance, pThis->pszIfName, pThis->pszBridge));
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnBeginXmit}
+ */
+static DECLCALLBACK(int) drvLinuxBridgeNetworkUp_BeginXmit(PPDMINETWORKUP pInterface, bool fOnWorkerThread)
+{
+    RT_NOREF(fOnWorkerThread);
+    PDRVLINUXBRIDGE pThis = PDMINETWORKUP_2_DRVLINUXBRIDGE(pInterface);
+    return RTCritSectEnter(&pThis->XmitLock);
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnAllocBuf}
+ */
+static DECLCALLBACK(int) drvLinuxBridgeNetworkUp_AllocBuf(PPDMINETWORKUP pInterface, size_t cbMin,
+                                                          PCPDMNETWORKGSO pGso, PPPDMSCATTERGATHER ppSgBuf)
+{
+    RT_NOREF(pInterface);
+    PPDMSCATTERGATHER pSgBuf = (PPDMSCATTERGATHER)RTMemAlloc(  RT_ALIGN_Z(sizeof(*pSgBuf), 16)
+                                                             + RT_ALIGN_Z(cbMin, 16)
+                                                             + (pGso ? RT_ALIGN_Z(sizeof(*pGso), 16) : 0));
+    if (!pSgBuf)
+        return VERR_NO_MEMORY;
+
+    pSgBuf->fFlags         = PDMSCATTERGATHER_FLAGS_MAGIC | PDMSCATTERGATHER_FLAGS_OWNER_1;
+    pSgBuf->cbUsed         = 0;
+    pSgBuf->cbAvailable    = RT_ALIGN_Z(cbMin, 16);
+    pSgBuf->pvAllocator    = NULL;
+    if (!pGso)
+        pSgBuf->pvUser     = NULL;
+    else
+    {
+        pSgBuf->pvUser     = (uint8_t *)(pSgBuf + 1) + pSgBuf->cbAvailable;
+        *(PPDMNETWORKGSO)pSgBuf->pvUser = *pGso;
+    }
+    pSgBuf->cSegs          = 1;
+    pSgBuf->aSegs[0].cbSeg = pSgBuf->cbAvailable;
+    pSgBuf->aSegs[0].pvSeg = pSgBuf + 1;
+
+    *ppSgBuf = pSgBuf;
+    return VINF_SUCCESS;
+}
