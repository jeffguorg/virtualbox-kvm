+    /* pszDescription */
+    "Linux TAP + host bridge network transport driver (driverless KVM backend)",
+    /* fFlags */
+    PDM_DRVREG_FLAGS_HOST_BITS_DEFAULT,
+    /* fClass. */
+    PDM_DRVREG_CLASS_NETWORK,
+    /* cMaxInstances */
+    ~0U,
+    /* cbInstance */
+    sizeof(DRVLINUXBRIDGE),
+    /* pfnConstruct */
+    drvLinuxBridgeConstruct,
+    /* pfnDestruct */
+    drvLinuxBridgeDestruct,
+    /* pfnRelocate */
+    NULL,
+    /* pfnIOCtl */
+    NULL,
+    /* pfnPowerOn */
