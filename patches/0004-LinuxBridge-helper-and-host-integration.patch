@@ -40,5 +40,16 @@ else
 endif
 VBoxNetAdpCtl_SOURCES   = VBoxNetAdpCtl.cpp
 
+# Setuid helper for the DrvLinuxBridge network driver: enslaves vboxtap*
+# interfaces to a host bridge via rtnetlink.  Linux only, as is the driver.
+if1of ($(KBUILD_TARGET), linux)
+ PROGRAMS                += VBoxNetBrCtl
+ # Always static: a setuid helper must be self-contained.  With a dynamic
+ # VBoxRT.so dependency, the RUNPATH=$ORIGin lookup is ignored by glibc for
+ # setuid binaries (AT_SECURE), so the helper could not find its runtime.
+ VBoxNetBrCtl_TEMPLATE   = VBoxR3Static
+ VBoxNetBrCtl_SOURCES     = VBoxNetBrCtl.cpp
+endif
+
 include $(FILE_KBUILD_SUB_FOOTER)
 
