+#
+# NEM KVM PIC state regression test.
+#
+tstNemKvmPicState_TEMPLATE := VBoxR3TstExe
+tstNemKvmPicState_DEFS     = IN_VMM_R3 VBOX_VMM_TARGET_X86 $(VMM_COMMON_DEFS)
+tstNemKvmPicState_INCS     = $(VBOX_PATH_VMM_SRC)/include
+tstNemKvmPicState_SOURCES  = tstNemKvmPicState.cpp
+tstNemKvmPicState_LIBS     = \
+	$(PATH_STAGE_LIB)/VMMStatic$(VBOX_SUFF_LIB) \
+	$(PATH_STAGE_LIB)/DisasmR3$(VBOX_SUFF_LIB) \
+	$(LIB_RUNTIME)
+tstNemKvmPicState_LDFLAGS.linux = -Wl,--wrap=ioctl
+
+
 
 #
 # ARMv8 PGM guest page table walking testcase.
diff --git a/src/VBox/VMM/testcase/tstNemKvmPicState.cpp b/src/VBox/VMM/testcase/tstNemKvmPicState.cpp
new file mode 100644
index 00000000..2d1fc416
--- /dev/null
+++ b/src/VBox/VMM/testcase/tstNemKvmPicState.cpp
@@ -0,0 +1,366 @@
+/* $Id: tstNemKvmPicState.cpp $ */
+/** @file
+ * NEM KVM PIC state regression test.
+ */
