 src/VBox/VMM/testcase/Makefile.kmk          |  17 +
 src/VBox/VMM/testcase/tstNemKvmPicState.cpp | 366 ++++++++++++++++++++
 3 files changed, 386 insertions(+)
 create mode 100644 src/VBox/VMM/testcase/tstNemKvmPicState.cpp

