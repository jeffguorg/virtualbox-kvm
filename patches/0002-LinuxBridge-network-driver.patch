diff --git a/src/VBox/Installer/linux/vboxbr0-setup.sh b/src/VBox/Installer/linux/vboxbr0-setup.sh
new file mode 100755
index 00000000..5336b1be
--- /dev/null
+++ b/src/VBox/Installer/linux/vboxbr0-setup.sh
@@ -0,0 +1,79 @@
+#!/bin/sh
+# vboxbr0-setup.sh - Host-side one-time setup for the LinuxBridge network driver.
+#
+# Creates the "vboxbr0" bridge with a static IP and starts dnsmasq bound to it
+# only, so guests attached via the LinuxBridge driver get DHCP/optional DNS.
+# Requires root. Re-run with "down" to tear everything down.
+#
+# Usage:
+#   sudo vboxbr0-setup.sh [up|down]
+#
+# What it does (up):
+#   1. ip link add vboxbr0 type bridge        (if absent)
+#   2. ip addr add 192.168.56.1/24 dev vboxbr0
+#   3. ip link set vboxbr0 up
+#   4. starts a dedicated dnsmasq instance:
+#        - bound to vboxbr0 only (DHCP + DNS on the bridge subnet)
+#        - leases file kept under /run to stay stateless
+#
+# Internet access for guests (optional, host-side, not done here):
+#   sysctl -w net.ipv4.ip_forward=1
+#   iptables -t nat -A POSTROUTING -s 192.168.56.0/24 -j MASQUERADE
+
+BRIDGE="${VBOXBR0_NAME:-vboxbr0}"
+SUBNET="${VBOXBR0_SUBNET:-192.168.56.0/24}"
+GATEWAY="${VBOXBR0_GW:-192.168.56.1}"
+DHCP_START="${VBOXBR0_DHCP_START:-192.168.56.100}"
+DHCP_END="${VBOXBR0_DHCP_END:-192.168.56.200}"
+LEASES="/run/vboxbr0-dnsmasq.leases"
+PIDFILE="/run/vboxbr0-dnsmasq.pid"
+
+set -e
+
+case "$1" in
+    up|"")
+        if ! ip link show "$BRIDGE" >/dev/null 2>&1; then
+            ip link add name "$BRIDGE" type bridge
+        fi
+        if ! ip addr show dev "$BRIDGE" | grep -q "$GATEWAY"; then
+            ip addr add "$GATEWAY/24" dev "$BRIDGE"
+        fi
+        ip link set "$BRIDGE" up
+
+        # Bridge ports (vboxtap*) are enslaved and brought up by
+        # VBoxNetBrCtl when a VM starts; nothing else to do here.
+
+        if ! command -v dnsmasq >/dev/null 2>&1; then
+            echo "dnsmasq not installed; bridge is up but guests get no DHCP." >&2
+            echo "Install dnsmasq or configure guest IPs statically." >&2
+            exit 0
+        fi
+        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
+            echo "dnsmasq already running for $BRIDGE (pid $(cat "$PIDFILE"))."
+            exit 0
+        fi
+        # port=0 would disable DNS; here DNS on the bridge is desired, so we
+        # keep it enabled but strictly interface-bound.
+        dnsmasq \
+            --bind-interfaces \
+            --interface="$BRIDGE" \
+            --dhcp-range="$DHCP_START,$DHCP_END,255.255.255.0,24h" \
+            --dhcp-option=3,"$GATEWAY" \
+            --dhcp-option=6,"$GATEWAY" \
+            --dhcp-leasefile="$LEASES" \
+            --pid-file="$PIDFILE" \
+            --except-interface=lo
+        echo "$BRIDGE up at $GATEWAY, dnsmasq serving $DHCP_START..$DHCP_END"
+        ;;
+
+    down)
+        [ -f "$PIDFILE" ] && kill "$(cat "$PIDFILE")" 2>/dev/null || true
+        ip link del "$BRIDGE" 2>/dev/null || true
+        echo "$BRIDGE torn down."
+        ;;
+
+    *)
+        echo "Usage: $0 [up|down]" >&2
+        exit 1
+        ;;
+esac
