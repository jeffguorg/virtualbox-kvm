+
+
+/**
+ * Asynchronous I/O thread for handling receive.
+ *
+ * @returns VINF_SUCCESS (ignored).
+ * @param   pDrvIns     Pointer to a DRVLINUXBRIDGE driver instance.
+ * @param   pThread     Thread handle.
+ */
+static DECLCALLBACK(int) drvLinuxBridgeAsyncIoThread(PPDMDRVINS pDrvIns, PPDMTHREAD pThread)
+{
+    PDRVLINUXBRIDGE pThis = PDMINS_2_DATA(pDrvIns, PDRVLINUXBRIDGE);
+    LogFlow(("drvLinuxBridgeAsyncIoThread: pThis=%p\n", pThis));
+
+    if (pThread->enmState == PDMTHREADSTATE_INITIALIZING)
+        return VINF_SUCCESS;
+
+    STAM_PROFILE_ADV_START(&pThis->StatReceive, a);
+
+    /*
+     * Polling loop.
+     */
+    while (pThread->enmState == PDMTHREADSTATE_RUNNING)
+    {
+        struct pollfd aFDs[2];
+        aFDs[0].fd      = RTFileToNative(pThis->hFileDevice);
+        aFDs[0].events  = POLLIN | POLLPRI;
+        aFDs[0].revents = 0;
+        aFDs[1].fd      = RTPipeToNative(pThis->hPipeRead);
+        aFDs[1].events  = POLLIN | POLLPRI | POLLERR | POLLHUP;
+        aFDs[1].revents = 0;
+        STAM_PROFILE_ADV_STOP(&pThis->StatReceive, a);
+        errno = 0;
+        int rc = poll(&aFDs[0], RT_ELEMENTS(aFDs), -1 /* infinite */);
+
+        if (pThread->enmState != PDMTHREADSTATE_RUNNING)
+            break;
+
+        STAM_PROFILE_ADV_START(&pThis->StatReceive, a);
+        if (    rc > 0
+            &&  (aFDs[0].revents & (POLLIN | POLLPRI))
+            &&  !aFDs[1].revents)
+        {
+            /*
+             * Read one frame and pass it up.
+             */
+            char achBuf[16384];
+            size_t cbRead = 0;
+            rc = RTFileRead(pThis->hFileDevice, achBuf, sizeof(achBuf), &cbRead);
+            if (RT_SUCCESS(rc))
+            {
+                STAM_PROFILE_ADV_STOP(&pThis->StatReceive, a);
+                int rc1 = pThis->pIAboveNet->pfnWaitReceiveAvail(pThis->pIAboveNet, RT_INDEFINITE_WAIT);
+                STAM_PROFILE_ADV_START(&pThis->StatReceive, a);
+                if (RT_FAILURE(rc1))
+                    continue;
+
+                STAM_COUNTER_INC(&pThis->StatPktRecv);
+                STAM_COUNTER_ADD(&pThis->StatPktRecvBytes, cbRead);
+                rc1 = pThis->pIAboveNet->pfnReceive(pThis->pIAboveNet, achBuf, cbRead);
+                AssertRC(rc1);
+            }
+            else
+            {
+                LogFlow(("drvLinuxBridgeAsyncIoThread: RTFileRead -> %Rrc\n", rc));
+                if (rc == VERR_INVALID_HANDLE)
+                    break;
+                RTThreadYield();
+            }
+        }
+        else if (rc > 0 && aFDs[1].revents)
+        {
+            LogFlow(("drvLinuxBridgeAsyncIoThread: control message: enmState=%d revents=%#x\n",
+                     pThread->enmState, aFDs[1].revents));
+            if (aFDs[1].revents & (POLLHUP | POLLERR | POLLNVAL))
+                break;
+
+            /* drain the pipe */
+            char ch;
+            size_t cbRead;
+            RTPipeRead(pThis->hPipeRead, &ch, 1, &cbRead);
+        }
+        else
+        {
+            if (errno == EINTR)
+                Log(("drvLinuxBridgeAsyncIoThread: EINTR, continuing\n"));
+            else
+                AssertMsgFailed(("rc=%d revents=%#x,%#x errno=%d %s\n",
+                                 rc, aFDs[0].revents, aFDs[1].revents, errno, strerror(errno)));
+            RTThreadYield();
+        }
+    }
+
+    LogFlow(("drvLinuxBridgeAsyncIoThread: returns\n"));
+    STAM_PROFILE_ADV_STOP(&pThis->StatReceive, a);
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * Unblock the receive thread so it can respond to a state change.
+ *
+ * @returns VBox status code.
+ * @param   pDrvIns     The pcnet device instance.
+ * @param   pThread     The send thread.
+ */
+static DECLCALLBACK(int) drvLinuxBridgeAsyncIoWakeup(PPDMDRVINS pDrvIns, PPDMTHREAD pThread)
+{
+    RT_NOREF(pThread);
+    PDRVLINUXBRIDGE pThis = PDMINS_2_DATA(pDrvIns, PDRVLINUXBRIDGE);
+
+    size_t cbIgnored;
+    int rc = RTPipeWrite(pThis->hPipeWrite, "", 1, &cbIgnored);
+    AssertRC(rc);
+
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * @interface_method_impl{PDMIBASE,pfnQueryInterface}
+ */
+static DECLCALLBACK(void *) drvLinuxBridgeQueryInterface(PPDMIBASE pInterface, const char *pszIID)
+{
+    PPDMDRVINS      pDrvIns = PDMIBASE_2_PDMDRV(pInterface);
+    PDRVLINUXBRIDGE pThis   = PDMINS_2_DATA(pDrvIns, PDRVLINUXBRIDGE);
+
+    PDMIBASE_RETURN_INTERFACE(pszIID, PDMIBASE, &pDrvIns->IBase);
+    PDMIBASE_RETURN_INTERFACE(pszIID, PDMINETWORKUP, &pThis->INetworkUp);
+    return NULL;
+}
+
+
+/**
+ * Destruct a driver instance.
+ *
+ * Most VM resources are freed by the VM. This callback is provided so that any non-VM
+ * resources can be freed correctly.
+ *
+ * @param   pDrvIns     The driver instance data.
+ */
+static DECLCALLBACK(void) drvLinuxBridgeDestruct(PPDMDRVINS pDrvIns)
+{
+    LogFlow(("drvLinuxBridgeDestruct\n"));
+    PDRVLINUXBRIDGE pThis = PDMINS_2_DATA(pDrvIns, PDRVLINUXBRIDGE);
+    PDMDRV_CHECK_VERSIONS_RETURN_VOID(pDrvIns);
+
+    int rc;
+
+    /*
+     * Detach the TAP from the bridge.  Best effort only: the TAP interface is
+     * non-persistent, so closing the fd removes it (and its bridge membership)
+     * anyway.  This just keeps the host tidy when the fd outlives the bridge.
+     */
+    if (pThis->fAttached && pThis->fDetachOnTerminate)
+    {
+        rc = drvLinuxBridgeRunCtl(pThis, "detach", NULL /*pszBridge*/);
+        if (RT_FAILURE(rc))
+            LogRel(("LinuxBridge#%d: warning: failed to detach '%s' (%Rrc)\n",
+                    pDrvIns->iInstance, pThis->pszIfName, rc));
+        pThis->fAttached = false;
+    }
+
+    /*
+     * Terminate the control pipe and close the TAP device.
+     */
+    if (pThis->hPipeWrite != NIL_RTPIPE)
+    {
+        rc = RTPipeClose(pThis->hPipeWrite); AssertRC(rc);
+        pThis->hPipeWrite = NIL_RTPIPE;
+    }
+    if (pThis->hPipeRead != NIL_RTPIPE)
+    {
+        rc = RTPipeClose(pThis->hPipeRead); AssertRC(rc);
+        pThis->hPipeRead = NIL_RTPIPE;
+    }
+
+    if (pThis->hFileDevice != NIL_RTFILE)
+    {
+        rc = RTFileClose(pThis->hFileDevice); AssertRC(rc);
+        pThis->hFileDevice = NIL_RTFILE;
+    }
+
+    PDMDrvHlpMMHeapFree(pDrvIns, pThis->pszIfName);
+    pThis->pszIfName = NULL;
+    PDMDrvHlpMMHeapFree(pDrvIns, pThis->pszBridge);
+    pThis->pszBridge = NULL;
+    PDMDrvHlpMMHeapFree(pDrvIns, pThis->pszCtlPath);
+    pThis->pszCtlPath = NULL;
+
+    if (RTCritSectIsInitialized(&pThis->XmitLock))
+        RTCritSectDelete(&pThis->XmitLock);
+
+#ifdef VBOX_WITH_STATISTICS
+    PDMDrvHlpSTAMDeregister(pDrvIns, &pThis->StatPktSent);
+    PDMDrvHlpSTAMDeregister(pDrvIns, &pThis->StatPktSentBytes);
+    PDMDrvHlpSTAMDeregister(pDrvIns, &pThis->StatPktRecv);
+    PDMDrvHlpSTAMDeregister(pDrvIns, &pThis->StatPktRecvBytes);
+    PDMDrvHlpSTAMDeregister(pDrvIns, &pThis->StatTransmit);
+    PDMDrvHlpSTAMDeregister(pDrvIns, &pThis->StatReceive);
+#endif /* VBOX_WITH_STATISTICS */
+}
+
+
+/**
+ * Construct a LinuxBridge network transport driver instance.
+ *
+ * @copydoc FNPDMDRVCONSTRUCT
+ */
+static DECLCALLBACK(int) drvLinuxBridgeConstruct(PPDMDRVINS pDrvIns, PCFGMNODE pCfg, uint32_t fFlags)
+{
+    RT_NOREF(fFlags);
+    PDMDRV_CHECK_VERSIONS_RETURN(pDrvIns);
+    PDRVLINUXBRIDGE pThis = PDMINS_2_DATA(pDrvIns, PDRVLINUXBRIDGE);
+    PCPDMDRVHLPR3   pHlp  = pDrvIns->pHlpR3;
+
+    /*
+     * Init the static parts.
+     */
+    pThis->pDrvIns                   = pDrvIns;
+    pThis->hFileDevice               = NIL_RTFILE;
+    pThis->pszIfName                 = NULL;
+    pThis->pszBridge                 = NULL;
+    pThis->pszCtlPath                = NULL;
+    pThis->fAttached                 = false;
+    pThis->fDetachOnTerminate        = true;
+    pThis->hPipeWrite                = NIL_RTPIPE;
+    pThis->hPipeRead                 = NIL_RTPIPE;
+
+    /* IBase */
+    pDrvIns->IBase.pfnQueryInterface = drvLinuxBridgeQueryInterface;
+    /* INetwork */
+    pThis->INetworkUp.pfnBeginXmit          = drvLinuxBridgeNetworkUp_BeginXmit;
+    pThis->INetworkUp.pfnAllocBuf           = drvLinuxBridgeNetworkUp_AllocBuf;
+    pThis->INetworkUp.pfnFreeBuf            = drvLinuxBridgeNetworkUp_FreeBuf;
+    pThis->INetworkUp.pfnSendBuf            = drvLinuxBridgeNetworkUp_SendBuf;
+    pThis->INetworkUp.pfnEndXmit            = drvLinuxBridgeNetworkUp_EndXmit;
+    pThis->INetworkUp.pfnSetPromiscuousMode = drvLinuxBridgeNetworkUp_SetPromiscuousMode;
+    pThis->INetworkUp.pfnNotifyLinkChanged  = drvLinuxBridgeNetworkUp_NotifyLinkChanged;
+
+#ifdef VBOX_WITH_STATISTICS
+    PDMDrvHlpSTAMRegisterF(pDrvIns, &pThis->StatPktSent,       STAMTYPE_COUNTER, STAMVISIBILITY_ALWAYS, STAMUNIT_OCCURENCES,     "Number of sent packets.",     "/Drivers/LinuxBridge%d/Packets/Sent", pDrvIns->iInstance);
+    PDMDrvHlpSTAMRegisterF(pDrvIns, &pThis->StatPktSentBytes,  STAMTYPE_COUNTER, STAMVISIBILITY_ALWAYS, STAMUNIT_BYTES,          "Number of sent bytes.",       "/Drivers/LinuxBridge%d/Bytes/Sent", pDrvIns->iInstance);
+    PDMDrvHlpSTAMRegisterF(pDrvIns, &pThis->StatPktRecv,       STAMTYPE_COUNTER, STAMVISIBILITY_ALWAYS, STAMUNIT_OCCURENCES,     "Number of received packets.", "/Drivers/LinuxBridge%d/Packets/Received", pDrvIns->iInstance);
+    PDMDrvHlpSTAMRegisterF(pDrvIns, &pThis->StatPktRecvBytes,  STAMTYPE_COUNTER, STAMVISIBILITY_ALWAYS, STAMUNIT_BYTES,          "Number of received bytes.",   "/Drivers/LinuxBridge%d/Bytes/Received", pDrvIns->iInstance);
+    PDMDrvHlpSTAMRegisterF(pDrvIns, &pThis->StatTransmit,      STAMTYPE_PROFILE, STAMVISIBILITY_ALWAYS, STAMUNIT_TICKS_PER_CALL, "Profiling packet transmit.",  "/Drivers/LinuxBridge%d/Transmit", pDrvIns->iInstance);
+    PDMDrvHlpSTAMRegisterF(pDrvIns, &pThis->StatReceive,       STAMTYPE_PROFILEADV, STAMVISIBILITY_ALWAYS, STAMUNIT_TICKS_PER_CALL, "Profiling packet receive.", "/Drivers/LinuxBridge%d/Receive", pDrvIns->iInstance);
+#endif /* VBOX_WITH_STATISTICS */
+
+    /*
+     * Validate the config.
+     */
+    PDMDRV_VALIDATE_CONFIG_RETURN(pDrvIns, "Bridge"
+                                           "|IfName"
+                                           "|CtlPath"
+                                           "|DetachOnTerminate"
+                                           "|MAC",
+                                           "");
+
+    /*
+     * Check that no-one is attached to us.
+     */
+    AssertMsgReturn(PDMDrvHlpNoAttach(pDrvIns) == VERR_PDM_NO_ATTACHED_DRIVER,
+                    ("Configuration error: Not possible to attach anything to this driver!\n"),
+                    VERR_PDM_DRVINS_NO_ATTACH);
+
+    /*
+     * Query the network port interface.
+     */
+    pThis->pIAboveNet = PDMIBASE_QUERY_INTERFACE(pDrvIns->pUpBase, PDMINETWORKDOWN);
+    if (!pThis->pIAboveNet)
+        return PDMDRV_SET_ERROR(pDrvIns, VERR_PDM_MISSING_INTERFACE_ABOVE,
+                                N_("Configuration error: The above device/driver didn't export the network port interface"));
+
+    /*
+     * Read the configuration.
+     */
+    int rc = pHlp->pfnCFGMQueryStringAlloc(pCfg, "Bridge", &pThis->pszBridge);
+    if (RT_FAILURE(rc))
+        return PDMDRV_SET_ERROR(pDrvIns, rc,
+                                N_("Configuration error: required property \"Bridge\" (host bridge name, e.g. vboxbr0) is missing"));
+
+    char szDefaultIfName[IFNAMSIZ];
+    RTStrPrintf(szDefaultIfName, sizeof(szDefaultIfName), "vboxtap%u", pDrvIns->iInstance);
+    rc = pHlp->pfnCFGMQueryStringAllocDef(pCfg, "IfName", &pThis->pszIfName, szDefaultIfName);
+    if (RT_FAILURE(rc))
+        return PDMDRV_SET_ERROR(pDrvIns, rc, N_("Configuration error: failed to read \"IfName\""));
+    if (RTStrNCmp(pThis->pszIfName, RT_STR_TUPLE("vboxtap")) != 0)
+        return PDMDRV_SET_ERROR(pDrvIns, VERR_INVALID_NAME,
+                                N_("Configuration error: \"IfName\" must have the 'vboxtap' prefix (enforced by VBoxNetBrCtl)"));
+    if (RTStrNLen(pThis->pszIfName, IFNAMSIZ) >= IFNAMSIZ)
+        return PDMDRV_SET_ERROR(pDrvIns, VERR_INVALID_NAME,
+                                N_("Configuration error: \"IfName\" is too long (IFNAMSIZ-1 max)"));
+
+    rc = pHlp->pfnCFGMQueryStringAlloc(pCfg, "CtlPath", &pThis->pszCtlPath);
+    if (rc == VERR_CFGM_VALUE_NOT_FOUND)
+    {
+        pThis->pszCtlPath = NULL;
+        rc = VINF_SUCCESS;
+    }
+    else if (RT_FAILURE(rc))
+        return PDMDRV_SET_ERROR(pDrvIns, rc, N_("Configuration error: failed to read \"CtlPath\""));
+
+    rc = pHlp->pfnCFGMQueryBool(pCfg, "DetachOnTerminate", &pThis->fDetachOnTerminate);
+    if (rc == VERR_CFGM_VALUE_NOT_FOUND)
+        rc = VINF_SUCCESS;
+    else if (RT_FAILURE(rc))
+        return PDMDRV_SET_ERROR(pDrvIns, rc, N_("Configuration error: failed to read \"DetachOnTerminate\""));
+
+    /*
+     * Create the TAP device and attach it to the bridge.
+     */
+    rc = drvLinuxBridgeAttach(pThis);
+    if (RT_FAILURE(rc))
+        return rc;
+
+    /*
+     * Create the transmit lock, control pipe and async I/O thread.
+     */
+    rc = RTCritSectInit(&pThis->XmitLock);
+    AssertRCReturn(rc, rc);
+
+    rc = RTPipeCreate(&pThis->hPipeRead, &pThis->hPipeWrite, 0 /*fFlags*/);
+    AssertRCReturn(rc, rc);
+
+    rc = PDMDrvHlpThreadCreate(pDrvIns, &pThis->pThread, pThis, drvLinuxBridgeAsyncIoThread,
+                               drvLinuxBridgeAsyncIoWakeup, 128 * _1K, RTTHREADTYPE_IO, "LnxBrdg");
+    AssertRCReturn(rc, rc);
+
+    return rc;
+}
+
+
+/**
+ * The LinuxBridge driver registration record.
+ */
+const PDMDRVREG g_DrvLinuxBridge =
+{
+    /* u32Version */
+    PDM_DRVREG_VERSION,
+    /* szName */
+    "LinuxBridge",
+    /* szRCMod */
+    "",
+    /* szR0Mod */
+    "",
+    /* pszDescription */
+    "Linux TAP + host bridge network transport driver (driverless KVM backend)",
+    /* fFlags */
+    PDM_DRVREG_FLAGS_HOST_BITS_DEFAULT,
+    /* fClass. */
+    PDM_DRVREG_CLASS_NETWORK,
+    /* cMaxInstances */
+    ~0U,
+    /* cbInstance */
+    sizeof(DRVLINUXBRIDGE),
+    /* pfnConstruct */
+    drvLinuxBridgeConstruct,
+    /* pfnDestruct */
+    drvLinuxBridgeDestruct,
+    /* pfnRelocate */
+    NULL,
+    /* pfnIOCtl */
+    NULL,
+    /* pfnPowerOn */
+    NULL,
+    /* pfnReset */
+    NULL,
+    /* pfnSuspend */
+    NULL,
+    /* pfnResume */
+    NULL,
+    /* pfnAttach */
+    NULL,
+    /* pfnDetach */
+    NULL,
+    /* pfnPowerOff */
+    NULL,
+    /* pfnSoftReset */
+    NULL,
+    /* u32VersionEnd */
+    PDM_DRVREG_VERSION
+};
