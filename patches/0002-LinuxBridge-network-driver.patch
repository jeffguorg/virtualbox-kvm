+
+#include <errno.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <sys/poll.h>
+#include <unistd.h>
+/* linux/if.h + linux/if_tun.h give us struct ifreq/IFF_* without
+ * conflicting with glibc's <net/if.h>, which must not be mixed in. */
+#include <linux/if.h>
+#include <linux/if_tun.h>
+
+#include "VBoxDD.h"
