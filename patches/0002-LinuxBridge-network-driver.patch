+/*********************************************************************************************************************************
+*   Structures and Typedefs                                                                                                      *
+*********************************************************************************************************************************/
+/**
+ * LinuxBridge driver instance data.
+ *
+ * @implements PDMINETWORKUP
+ */
+typedef struct DRVLINUXBRIDGE
+{
+    /** The network interface. */
+    PDMINETWORKUP           INetworkUp;
+    /** The network port interface of the driver/device above us. */
+    PPDMINETWORKDOWN        pIAboveNet;
+    /** Pointer to the driver instance. */
+    PPDMDRVINS              pDrvIns;
+    /** TAP device file handle. */
+    RTFILE                  hFileDevice;
+    /** The TAP device name (always "vboxtap*" prefixed). */
+    char                   *pszIfName;
+    /** The host bridge name. */
+    char                   *pszBridge;
+    /** Explicit path of the VBoxNetBrCtl helper, NULL for default lookup. */
+    char                   *pszCtlPath;
+    /** Whether the helper successfully attached the TAP to the bridge. */
+    bool                    fAttached;
+    /** Whether to detach on terminate (default true). */
+    bool                    fDetachOnTerminate;
+    /** The write end of the control pipe. */
+    RTPIPE                  hPipeWrite;
+    /** The read end of the control pipe. */
+    RTPIPE                  hPipeRead;
+    /** Reader thread. */
+    PPDMTHREAD              pThread;
+    /** Transmit lock used by drvLinuxBridgeNetworkUp_BeginXmit. */
+    RTCRITSECT              XmitLock;
+
+#ifdef VBOX_WITH_STATISTICS
+    /** Number of sent packets. */
+    STAMCOUNTER             StatPktSent;
+    /** Number of sent bytes. */
+    STAMCOUNTER             StatPktSentBytes;
+    /** Number of received packets. */
+    STAMCOUNTER             StatPktRecv;
+    /** Number of received bytes. */
+    STAMCOUNTER             StatPktRecvBytes;
+    /** Profiling packet transmit runs. */
+    STAMPROFILE             StatTransmit;
+    /** Profiling packet receive runs. */
+    STAMPROFILEADV          StatReceive;
+#endif /* VBOX_WITH_STATISTICS */
+} DRVLINUXBRIDGE, *PDRVLINUXBRIDGE;
+
+
+/** Converts a pointer to DRVLINUXBRIDGE::INetworkUp to a PDRVLINUXBRIDGE. */
+#define PDMINETWORKUP_2_DRVLINUXBRIDGE(pInterface) \
+    ( (PDRVLINUXBRIDGE)((uintptr_t)pInterface - RT_UOFFSETOF(DRVLINUXBRIDGE, INetworkUp)) )
+
+
+/*********************************************************************************************************************************
+*   Internal Functions                                                                                                           *
+*********************************************************************************************************************************/
+/**
+ * Locates the VBoxNetBrCtl helper executable.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszBuf      Where to store the full path.
+ * @param   cbBuf       Size of the buffer.
+ */
+static int drvLinuxBridgeResolveCtlPath(PDRVLINUXBRIDGE pThis, char *pszBuf, size_t cbBuf)
+{
+    int rc;
+    if (pThis->pszCtlPath && *pThis->pszCtlPath)
+        rc = RTStrCopy(pszBuf, cbBuf, pThis->pszCtlPath);
+    else
+    {
+        rc = RTPathExecDir(pszBuf, cbBuf - sizeof("/VBoxNetBrCtl"));
+        if (RT_SUCCESS(rc))
+            rc = RTStrCat(pszBuf, cbBuf, "/VBoxNetBrCtl");
+    }
+    if (RT_FAILURE(rc))
+        return rc;
+    if (!RTPathExists(pszBuf))
+        return VERR_FILE_NOT_FOUND;
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * Runs "VBoxNetBrCtl <action> <ifname> [bridge]" and waits for it.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ * @param   pszAction   "attach" or "detach".
+ * @param   pszBridge   The bridge name, NULL for detach.
+ */
+static int drvLinuxBridgeRunCtl(PDRVLINUXBRIDGE pThis, const char *pszAction, const char *pszBridge)
+{
+    char szCtl[RTPATH_MAX];
+    int rc = drvLinuxBridgeResolveCtlPath(pThis, szCtl, sizeof(szCtl));
+    if (RT_FAILURE(rc))
+    {
+        LogRel(("LinuxBridge#%d: cannot find VBoxNetBrCtl helper (%Rrc)\n", pThis->pDrvIns->iInstance, rc));
+        return rc;
+    }
+
+    const char *apszArgs[5];
+    apszArgs[0] = szCtl;
+    apszArgs[1] = pszAction;
+    apszArgs[2] = pThis->pszIfName;
+    apszArgs[3] = pszBridge;
+    apszArgs[4] = NULL;
+
+    RTPROCESS hProc;
+    rc = RTProcCreate(szCtl, apszArgs, RTENV_DEFAULT, 0 /*fFlags*/, &hProc);
+    if (RT_FAILURE(rc))
+    {
+        LogRel(("LinuxBridge#%d: failed to execute '%s %s %s %s': %Rrc\n",
+                pThis->pDrvIns->iInstance, szCtl, pszAction, pThis->pszIfName,
+                pszBridge ? pszBridge : "", rc));
+        return rc;
+    }
+
+    RTPROCSTATUS Status;
+    rc = RTProcWait(hProc, 0 /*fFlags*/, &Status);
+    if (RT_FAILURE(rc))
+        return rc;
+    if (Status.enmReason != RTPROCEXITREASON_NORMAL || Status.iStatus != 0)
+    {
+        LogRel(("LinuxBridge#%d: '%s %s %s %s' failed: iStatus=%d enmReason=%d\n",
+                pThis->pDrvIns->iInstance, szCtl, pszAction, pThis->pszIfName,
+                pszBridge ? pszBridge : "", Status.iStatus, Status.enmReason));
+        return VERR_ACCESS_DENIED;
+    }
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * Creates the TAP interface and attaches it to the host bridge.
+ *
+ * @returns VBox status code.
+ * @param   pThis       The instance data.
+ */
+static int drvLinuxBridgeAttach(PDRVLINUXBRIDGE pThis)
+{
+    /*
+     * Open the TUN/TAP control device and create the interface.
+     */
+    int fd = open("/dev/net/tun", O_RDWR | O_NONBLOCK);
+    if (fd < 0)
+        return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                   N_("Failed to open /dev/net/tun: %s (check tun module and group access)"),
+                                   strerror(errno));
+
+    struct ifreq IfReq;
+    memset(&IfReq, 0, sizeof(IfReq));
+    IfReq.ifr_flags = IFF_TAP | IFF_NO_PI;
+    RTStrCopy(IfReq.ifr_name, sizeof(IfReq.ifr_name), pThis->pszIfName);
+    if (ioctl(fd, TUNSETIFF, &IfReq) < 0)
+    {
+        int const iErr = errno;
+        close(fd);
+        return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                   N_("TUNSETIFF failed for '%s': %s"), pThis->pszIfName, strerror(iErr));
+    }
+
+    /* TUNSETIFF returns the name it actually bound; with a requested name
+     * present it is always exactly that name (created or attached), so no
+     * write-back is needed and pszIfName stays authoritative. */
+    pThis->hFileDevice = (RTFILE)(uintptr_t)fd;
+
+    /*
+     * Enslave to the host bridge via the setuid helper.
+     */
+    int rc = drvLinuxBridgeRunCtl(pThis, "attach", pThis->pszBridge);
+    if (RT_FAILURE(rc))
+        return PDMDrvHlpVMSetError(pThis->pDrvIns, VERR_HOSTIF_INIT_FAILED, RT_SRC_POS,
+                                   N_("Failed to attach '%s' to bridge '%s' via VBoxNetBrCtl; "
+                                      "is the bridge configured and VBoxNetBrCtl installed setuid root?"),
+                                   pThis->pszIfName, pThis->pszBridge);
+    pThis->fAttached = true;
+    LogRel(("LinuxBridge#%d: attached '%s' to bridge '%s'\n",
+            pThis->pDrvIns->iInstance, pThis->pszIfName, pThis->pszBridge));
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnBeginXmit}
+ */
+static DECLCALLBACK(int) drvLinuxBridgeNetworkUp_BeginXmit(PPDMINETWORKUP pInterface, bool fOnWorkerThread)
+{
+    RT_NOREF(fOnWorkerThread);
+    PDRVLINUXBRIDGE pThis = PDMINETWORKUP_2_DRVLINUXBRIDGE(pInterface);
+    return RTCritSectEnter(&pThis->XmitLock);
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnAllocBuf}
+ */
+static DECLCALLBACK(int) drvLinuxBridgeNetworkUp_AllocBuf(PPDMINETWORKUP pInterface, size_t cbMin,
+                                                          PCPDMNETWORKGSO pGso, PPPDMSCATTERGATHER ppSgBuf)
+{
+    RT_NOREF(pInterface);
+    PPDMSCATTERGATHER pSgBuf = (PPDMSCATTERGATHER)RTMemAlloc(  RT_ALIGN_Z(sizeof(*pSgBuf), 16)
+                                                             + RT_ALIGN_Z(cbMin, 16)
+                                                             + (pGso ? RT_ALIGN_Z(sizeof(*pGso), 16) : 0));
+    if (!pSgBuf)
+        return VERR_NO_MEMORY;
+
+    pSgBuf->fFlags         = PDMSCATTERGATHER_FLAGS_MAGIC | PDMSCATTERGATHER_FLAGS_OWNER_1;
+    pSgBuf->cbUsed         = 0;
+    pSgBuf->cbAvailable    = RT_ALIGN_Z(cbMin, 16);
+    pSgBuf->pvAllocator    = NULL;
+    if (!pGso)
+        pSgBuf->pvUser     = NULL;
+    else
+    {
+        pSgBuf->pvUser     = (uint8_t *)(pSgBuf + 1) + pSgBuf->cbAvailable;
+        *(PPDMNETWORKGSO)pSgBuf->pvUser = *pGso;
+    }
+    pSgBuf->cSegs          = 1;
+    pSgBuf->aSegs[0].cbSeg = pSgBuf->cbAvailable;
+    pSgBuf->aSegs[0].pvSeg = pSgBuf + 1;
+
+    *ppSgBuf = pSgBuf;
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnFreeBuf}
+ */
+static DECLCALLBACK(int) drvLinuxBridgeNetworkUp_FreeBuf(PPDMINETWORKUP pInterface, PPDMSCATTERGATHER pSgBuf)
+{
+    RT_NOREF(pInterface);
+    if (pSgBuf)
+    {
+        Assert((pSgBuf->fFlags & PDMSCATTERGATHER_FLAGS_MAGIC_MASK) == PDMSCATTERGATHER_FLAGS_MAGIC);
+        pSgBuf->fFlags = 0;
+        RTMemFree(pSgBuf);
+    }
+    return VINF_SUCCESS;
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnSendBuf}
+ */
+static DECLCALLBACK(int) drvLinuxBridgeNetworkUp_SendBuf(PPDMINETWORKUP pInterface, PPDMSCATTERGATHER pSgBuf, bool fOnWorkerThread)
+{
+    RT_NOREF(fOnWorkerThread);
+    PDRVLINUXBRIDGE pThis = PDMINETWORKUP_2_DRVLINUXBRIDGE(pInterface);
+    STAM_COUNTER_INC(&pThis->StatPktSent);
+    STAM_COUNTER_ADD(&pThis->StatPktSentBytes, pSgBuf->cbUsed);
+    STAM_PROFILE_START(&pThis->StatTransmit, a);
+
+    AssertPtr(pSgBuf);
+    Assert((pSgBuf->fFlags & PDMSCATTERGATHER_FLAGS_MAGIC_MASK) == PDMSCATTERGATHER_FLAGS_MAGIC);
+    Assert(RTCritSectIsOwner(&pThis->XmitLock));
+
+    int rc;
+    if (!pSgBuf->pvUser)
+        rc = RTFileWrite(pThis->hFileDevice, pSgBuf->aSegs[0].pvSeg, pSgBuf->cbUsed, NULL);
+    else
+    {
+        /* GSO: carve into plain frames, the TAP device has no offload headers. */
+        uint8_t         abHdrScratch[256];
+        uint8_t const  *pbFrame = (uint8_t const *)pSgBuf->aSegs[0].pvSeg;
+        PCPDMNETWORKGSO pGso    = (PCPDMNETWORKGSO)pSgBuf->pvUser;
+        uint32_t const  cSegs   = PDMNetGsoCalcSegmentCount(pGso, pSgBuf->cbUsed);
+        Assert(cSegs > 1);
+        rc = VINF_SUCCESS;
+        for (size_t iSeg = 0; iSeg < cSegs; iSeg++)
+        {
+            uint32_t cbSegFrame;
+            void *pvSegFrame = PDMNetGsoCarveSegmentQD(pGso, (uint8_t *)pbFrame, pSgBuf->cbUsed, abHdrScratch,
+                                                       iSeg, cSegs, &cbSegFrame);
+            rc = RTFileWrite(pThis->hFileDevice, pvSegFrame, cbSegFrame, NULL);
+            if (RT_FAILURE(rc))
+                break;
+        }
+    }
+
+    pSgBuf->fFlags = 0;
+    RTMemFree(pSgBuf);
+
+    STAM_PROFILE_STOP(&pThis->StatTransmit, a);
+    if (RT_FAILURE(rc))
+        rc = rc == VERR_NO_MEMORY ? VERR_NET_NO_BUFFER_SPACE : VERR_NET_DOWN;
+    return rc;
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnEndXmit}
+ */
+static DECLCALLBACK(void) drvLinuxBridgeNetworkUp_EndXmit(PPDMINETWORKUP pInterface)
+{
+    PDRVLINUXBRIDGE pThis = PDMINETWORKUP_2_DRVLINUXBRIDGE(pInterface);
+    RTCritSectLeave(&pThis->XmitLock);
+}
+
+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnSetPromiscuousMode}
+ */
+static DECLCALLBACK(void) drvLinuxBridgeNetworkUp_SetPromiscuousMode(PPDMINETWORKUP pInterface, bool fPromiscuous)
+{
+    RT_NOREF(pInterface, fPromiscuous);
+    /* Bridge port membership already delivers what the guest needs. */
+}
