+
+/**
+ * @interface_method_impl{PDMINETWORKUP,pfnNotifyLinkChanged}
+ */
+static DECLCALLBACK(void) drvLinuxBridgeNetworkUp_NotifyLinkChanged(PPDMINETWORKUP pInterface, PDMNETWORKLINKSTATE enmLinkState)
+{
+    RT_NOREF(pInterface, enmLinkState);
+    LogFlow(("drvLinuxBridgeNetworkUp_NotifyLinkChanged: enmLinkState=%d\n", enmLinkState));
